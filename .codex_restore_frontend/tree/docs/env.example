# Copy to .env or .env.local and fill in values.

# PostgreSQL connection string (required for Drizzle and db:migrate)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Supabase: use the connection string from Project Settings → Database.
# - Transaction pooler (recommended): port 6543, user like postgres.PROJECT_REF
# - Session pooler: port 5432
# Replace the password with your actual database password (not [YOUR-PASSWORD]).
# If the password contains special characters, URL-encode them (e.g. @ → %40).
#
# Example (Supabase pooler):
#   DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_ACTUAL_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Example (local Postgres):
#   DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/releasepilot
DATABASE_URL=postgresql://user:password@localhost:5432/releasepilot

# For encrypting stored App Store Connect keys (32 bytes hex or long random string)
ENCRYPTION_KEY=your-32-byte-secret

# Application base URL (use local tunnel URL in dev for GitHub callbacks)
APP_BASE_URL=https://your-app.example.com
# Better Auth base URL (optional when APP_BASE_URL is set)
# BETTER_AUTH_URL=https://your-app.example.com
# Better Auth signing secret (required, 32+ chars random string)
BETTER_AUTH_SECRET=replace-with-32-plus-char-random-secret

# GitHub App configuration
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=releasepilot
GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_APP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional aliases used by auth provider lookup:
# GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
# GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# AI for rejection-fix suggestions (optional; required for "Get AI suggestions" on fix page)
OPENAI_API_KEY=sk-...
