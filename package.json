{
  "name": "ReleasePilotMono",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev smee-client --parallel",
    "dev:webhooks": "pnpm --filter releasepilot smee-client",
    "dev:frontend": "pnpm --filter releasepilot dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.19",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
